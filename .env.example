# ---- Postgres (docker-compose reads these) ----
POSTGRES_USER=lead
POSTGRES_PASSWORD=leadpass
POSTGRES_DB=lead_automation

# ---- Database URL ----
# Used when running services LOCALLY (outside compose). Inside compose the
# service blocks override the host to 'postgres'.
DATABASE_URL=postgres://lead:leadpass@localhost:5432/lead_automation

# ---- Auth ----
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=1d

# ---- Gateway -> service targets ----
# Compose network hostnames. Leave as-is for docker-compose. For local runs the
# gateway falls back to http://localhost:<port> defaults, so these can be blank.

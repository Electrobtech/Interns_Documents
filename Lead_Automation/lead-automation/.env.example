# ---- Postgres (docker-compose reads these) ----
POSTGRES_USER=lead
POSTGRES_PASSWORD=leadpass
POSTGRES_DB=lead_automation

# ---- Database URL ----
# Used when running services LOCALLY (outside compose). Inside compose the
# service blocks override the host to 'postgres'.
DATABASE_URL=postgres://lead:leadpass@localhost:5432/lead_automation

# ---- Auth ----
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=1d

# ---- Lead Automation module (now Postgres-backed via DATABASE_URL above) ----
AUTOMATION_PORT=4011
# Publicly reachable base URL for this service, used to build links to
# uploaded documents (services/automation-service/src/controllers/mediaController.js).
# The WhatsApp Cloud API fetches these URLs directly from Meta's servers, so
# "http://localhost:4011" (the default) only works in Simulate mode — set
# this to a real public hostname (or swap in S3) before sending live.
AUTOMATION_PUBLIC_URL=

# ---- WhatsApp / channel provider credentials for the Automation module ----
# (fill in once you connect real channel webhooks; unused in Simulate mode)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- Instagram (Meta Graph API, via a Creator account + linked Page) ----
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# ---- Gateway -> service targets ----
# Compose network hostnames. Leave as-is for docker-compose. For local runs the
# gateway falls back to http://localhost:<port> defaults, so these can be blank.
AUTH_SERVICE_URL=http://auth-service:4001
INBOX_SERVICE_URL=http://inbox-service:4002
CONTACT_SERVICE_URL=http://contact-service:4003
CAMPAIGN_SERVICE_URL=http://campaign-service:4004
AI_SERVICE_URL=http://ai-service:4005
ECOMMERCE_SERVICE_URL=http://ecommerce-service:4006
REVIEW_SERVICE_URL=http://review-service:4007
ANALYTICS_SERVICE_URL=http://analytics-service:4008
INTEGRATION_SERVICE_URL=http://integration-service:4009
TEAM_SERVICE_URL=http://team-service:4010
AUTOMATION_SERVICE_URL=http://automation-service:4011
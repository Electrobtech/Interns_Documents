# ---- WhatsApp Cloud API ----
# These are NOT read at runtime — WhatsApp credentials are saved per
# organization via POST /whatsapp/connect (see services/integration-service/
# src/routes/whatsapp.js) and stored encrypted in Postgres, same as the
# Instagram/Facebook connection. Listed here only as a reference for what
# to paste into that endpoint.
# Get these from Meta Business Manager > WhatsApp > API Setup:
#   WHATSAPP_PHONE_NUMBER_ID     - the Phone Number ID (not the phone number itself)
#   WHATSAPP_BUSINESS_ACCOUNT_ID - the WABA ID
#   WHATSAPP_ACCESS_TOKEN        - a permanent System User token scoped to
#                                  whatsapp_business_messaging + whatsapp_business_management
# The webhook itself reuses META_APP_SECRET (signature) and
# META_WEBHOOK_VERIFY_TOKEN (handshake) above — same Meta App as FB/IG.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

PORT=5000
# ---- Postgres (docker-compose reads these) ----
# POSTGRES_USER is an admin/migration-only role (it's the superuser initdb
# creates) — used to load schema.sql/seed.sql/rls.sql, NOT what the app
# connects as. Superusers always bypass Postgres Row-Level Security, so if
# the app used this role, every tenant-isolation policy in infra/db/rls.sql
# would silently do nothing.
POSTGRES_USER=lead
POSTGRES_PASSWORD=leadpass
POSTGRES_DB=lead_automation

# app_user is the ordinary, non-superuser role the app actually connects as
# (see infra/db/00-app-role.sh, which creates it, and infra/db/rls.sql,
# which grants it table access). Change this password for anything beyond
# local dev.
APP_DB_PASSWORD=apppass

# ---- Database URL ----
# Used when running services LOCALLY (outside compose). Inside compose the
# service blocks override the host to 'postgres'. Points at app_user, not
# POSTGRES_USER — see the RLS note above.
DATABASE_URL=postgres://app_user:apppass@localhost:5432/lead_automation

# ---- Auth ----
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=1d

# ---- Gateway -> service targets ----
# Compose network hostnames. Leave as-is for docker-compose. For local runs the
# gateway falls back to http://localhost:<port> defaults, so these can be blank.
AUTH_SERVICE_URL=http://auth-service:4001
INBOX_SERVICE_URL=http://inbox-service:4002
CONTACT_SERVICE_URL=http://contact-service:4003
CAMPAIGN_SERVICE_URL=http://campaign-service:4004
AI_SERVICE_URL=http://ai-service:4005
ECOMMERCE_SERVICE_URL=http://ecommerce-service:4006
REVIEW_SERVICE_URL=http://review-service:4007
ANALYTICS_SERVICE_URL=http://analytics-service:4008
INTEGRATION_SERVICE_URL=http://integration-service:4009
TEAM_SERVICE_URL=http://team-service:4010



# =============================================================================
#  Lead Automation Platform — environment variable reference
#  Copy this file to .env and fill in your values.
#  NEVER commit .env — it is gitignored.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose project name
# Avoids collisions if you have multiple checkouts of this repo on one machine.
# ─────────────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=lead-automation-docs


# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL  (pgvector/pgvector:pg16 image)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=lead
POSTGRES_PASSWORD=leadpass
POSTGRES_DB=lead_automation

# Used when running services LOCALLY (outside compose).
# Inside compose, each service block overrides the host to 'postgres'.
DATABASE_URL=postgres://lead:leadpass@localhost:5432/lead_automation


# ─────────────────────────────────────────────────────────────────────────────
# Auth  (JWT shared across all services)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=1d


# ─────────────────────────────────────────────────────────────────────────────
# AI Agent Service  (FastAPI / Python — Marketing, Sales, Support agents)
# ─────────────────────────────────────────────────────────────────────────────

# Primary LLM provider: "groq" | "ollama"
LLM_PROVIDER=groq
# Fallback if primary fails
LLM_FALLBACK_PROVIDER=ollama

# Groq — fast Llama 3.3 inference for AI content generation
# Required for Marketing Hub AI features (Content Studio, Templates, etc.)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — local fallback generation + ALL embeddings
# Inside compose the host is always http://ollama:11434
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:8b

# Embedding model served by Ollama (768-dim — matches pgvector Vector(768))
# Run: docker exec ollama ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# ─────────────────────────────────────────────────────────────────────────────
# Marketing Hub Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Marketing Hub Service Port
MARKETING_HUB_PORT=4016

# AI Overview Service URL (for Content Studio AI generation)
AI_OVERVIEW_SERVICE_URL=http://ai-overview-service:4020

# File Upload Settings for Assets Library
MAX_FILE_SIZE=300MB

# Channel Simulation Settings (for development - replace with real APIs later)
SIMULATION_MODE=true
SIMULATION_BATCH_SIZE=100
SIMULATION_DELAY_MS=1000

# Channel Provider Settings
# WhatsApp Business API (simulation mode - set WHATSAPP_SIMULATION=false for real API)
WHATSAPP_SIMULATION=true
WHATSAPP_SUCCESS_RATE=0.85

# Email Provider Settings (simulation mode - set EMAIL_SIMULATION=false for real API)
EMAIL_SIMULATION=true
EMAIL_SUCCESS_RATE=0.92

# SMS Provider Settings (simulation mode - set SMS_SIMULATION=false for real API)
SMS_SIMULATION=true
SMS_SUCCESS_RATE=0.89

# Social Media Simulation Settings
FACEBOOK_SIMULATION=true
INSTAGRAM_SIMULATION=true
LINKEDIN_SIMULATION=true

# Marketing Analytics Configuration
ANALYTICS_RETENTION_DAYS=90
REAL_TIME_UPDATES=true

# File Upload Settings for Assets Library
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,svg,pdf,doc,docx,mp4,mov,avi,mp3,wav


# ─────────────────────────────────────────────────────────────────────────────
# GST Verification (auth-service, POST /company/verify-gst — Step 1 of the
# registration wizard). Server-side ONLY. The frontend never sees this key;
# it only calls our own /company/verify-gst endpoint. See
# services/auth-service/src/services/gstService.js.
# ─────────────────────────────────────────────────────────────────────────────
RAPIDAPI_KEY=
# Host header for the RapidAPI GST-verification API you subscribed to, e.g.
# "gst-verification-api.p.rapidapi.com".
RAPIDAPI_GST_HOST=
# Full https:// URL of that same API's verification endpoint.
RAPIDAPI_GST_URL=
# HTTP method your specific RapidAPI listing expects — check its
# "Code Snippets" tab. Most GST verification/insights listings are GET;
# a few are POST. Sending the wrong one gets a blanket 404 from
# RapidAPI's gateway (looks exactly like "GSTIN not found" for every
# number). If RAPIDAPI_GST_URL contains a `{gstin}` placeholder it is
# substituted into the path instead of appended as a query param.
RAPIDAPI_GST_METHOD=GET
# How long a verified GSTIN is served from our own DB cache before we call
# RapidAPI again for it.
GST_CACHE_TTL_DAYS=30


# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js 14)
# ─────────────────────────────────────────────────────────────────────────────
# The browser-side base URL for all API calls. Points at the gateway.
# In production, replace with your public domain, e.g. https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8080


# ─────────────────────────────────────────────────────────────────────────────
# Automation Service  (port 4011)
# ─────────────────────────────────────────────────────────────────────────────
AUTOMATION_PORT=4011

# Publicly reachable base URL for uploaded media (WhatsApp fetches these URLs
# directly from Meta servers, so localhost only works in Simulate mode).
# Set to a real public hostname or S3 URL before going live.
AUTOMATION_PUBLIC_URL=

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Instagram (Meta Graph API via Creator account + linked Page)
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# ---- Google Business Profile Reviews (Reviews & Social module, review-service) ----
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console and request access to the Business Profile APIs.
# These act as a FALLBACK only: each organization can instead configure its
# own Client ID / Client Secret from Reviews > Google Reviews in the app
# (POST /google/config), which takes precedence when set. See
# services/review-service/src/google/configStore.js.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client, and must
# point at the API GATEWAY (not review-service directly), since that's the
# frontend's only public entry point: http://localhost:8080/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/google/callback
# Public URL of the frontend, used to redirect the browser back after the
# Google consent screen (success or failure).
FRONTEND_URL=http://localhost:3000
# 32-byte key (hex or base64) used to encrypt stored Google refresh tokens.
# Generate with: openssl rand -hex 32
# Optional for local dev — if unset, refresh tokens are stored in plain
# text and a warning is logged. Set this in any shared/production env.
GOOGLE_TOKEN_ENC_KEY=
# How often the background job pulls new/edited reviews from Google.
GOOGLE_SYNC_INTERVAL_MINUTES=15


# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn Integration Service  (port 4009)
# ─────────────────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4009/api/v1/integrations/linkedin/callback
LINKEDIN_WEBHOOK_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# Inter-service URLs
# Compose network hostnames. Leave as-is for docker-compose. For local runs the
# gateway falls back to http://localhost:<port> defaults, so these can be blank.
# ─────────────────────────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:4001
INBOX_SERVICE_URL=http://inbox-service:4002
CONTACT_SERVICE_URL=http://contact-service:4003
CAMPAIGN_SERVICE_URL=http://campaign-service:4004
AI_SERVICE_URL=http://ai-agent-service:4005
ECOMMERCE_SERVICE_URL=http://ecommerce-service:4006
REVIEW_SERVICE_URL=http://review-service:4007
ANALYTICS_SERVICE_URL=http://analytics-service:4008
INTEGRATION_SERVICE_URL=http://integration-service:4008
LINKEDIN_SERVICE_URL=http://linkedin-service:4009
TEAM_SERVICE_URL=http://team-service:4010
AUTOMATION_SERVICE_URL=http://automation-service:4011


# ─────────────────────────────────────────────────────────────────────────────
# Additional Meta/Facebook Configuration (from lead-automation)
# ─────────────────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4009/auth/facebook/callback
META_GRAPH_API_VERSION=v25.0
META_GRAPH_API_BASE=https://graph.facebook.com
REDIS_URL=redis://redis:6379
META_WEBHOOK_VERIFY_TOKEN=
CREDENTIALS_ENCRYPTION_KEY=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
IG_APP_SECRET=
META_WEBHOOK_URL=http://localhost:4009/webhook/meta
PORT=5000




# ─────────────────────────────────────────────────────────────────────────────
# Email Service — Gmail integration  (port 4013)
# ─────────────────────────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console and enable the Gmail API. Separate from review-service's
# GOOGLE_CLIENT_ID/SECRET above — Gmail requests different scopes
# (gmail.modify) and a user may connect one without the other.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client, and
# must point at the API GATEWAY (not email-service directly):
GMAIL_REDIRECT_URI=http://localhost:8080/email/auth/callback
EMAIL_PORT=4013
# Publicly reachable base URL for cached attachment bytes (both inbound
# Gmail attachments and outgoing ones users compose with). Set to a real
# public hostname before going live if anyone needs to open these links
# directly rather than through the app.
EMAIL_PUBLIC_URL=
# 32-byte key (hex or base64) used to encrypt stored Gmail OAuth tokens.
# Generate with: openssl rand -hex 32
# Optional for local dev — if unset, tokens are stored in plain text and a
# warning is logged. Set this in any shared/production env.
EMAIL_TOKEN_ENC_KEY=
# How often the polling fallback checks connected mailboxes for new mail.
# This always runs, even when Pub/Sub push (below) is also configured.
EMAIL_POLL_INTERVAL_MINUTES=5
# ---- Optional: real-time push via Cloud Pub/Sub, instead of relying only
# on the polling fallback above. See services/email-service/README.md for
# the one-time Cloud Pub/Sub topic/subscription setup. ----
GMAIL_PUBSUB_TOPIC=
# Shared secret appended to the Pub/Sub push subscription's endpoint URL
# (.../webhook/gmail?token=...) — see services/email-service/src/controllers/webhookController.js
# for why this, rather than full OIDC verification, is used here.
GMAIL_PUBSUB_VERIFY_TOKEN=


# ---- Email Verification (BrevoAPI) — see .env.example for details ----
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=Lead Automation

# ---- Phone Number Verification (BrevoAPI) — see .env.example for details ----
OTP_ENABLED=true
SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=your_actual_2factor_api_key_here
TWOFACTOR_TEMPLATE=Electrobtech_Login_OTP
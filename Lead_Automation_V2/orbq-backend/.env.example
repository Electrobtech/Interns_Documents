# Orbq — local development. GITIGNORED. Never commit.
ENVIRONMENT=local
LOG_JSON=false
LOG_LEVEL=INFO

ORBQ_DB_USER=orbq
ORBQ_DB_PASSWORD=orbqpass
RABBITMQ_USER=orbq
RABBITMQ_PASSWORD=orbqpass

# Must match the Node auth-service secret — Orbq verifies tokens, never issues them.
JWT_SECRET=change-me-in-prod
INTERNAL_SIGNING_KEY=dev-internal-signing-key

# LLM. llama-3.3-70b-versatile chosen over qwen3.6-27b on measured evidence:
# qwen fails Groq strict JSON mode ("Failed to validate JSON"), which every
# capability depends on. It is also better calibrated than gpt-oss-120b, which
# returned 0.93 confidence with an empty knowledge base.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama: generation fallback, and ALWAYS the embedder (Groq has no embeddings API).
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text

RAG_LLM_RERANK=false
RAG_CONFIDENCE_THRESHOLD=0.50
